{
    "tasks": [
        {
            "label": "compileCurrentFile",
            "type": "shell",
            "command": "g++",
            "args": [
                "-O0",
                "-g3",
                "${file}",
                "-o",
                "${fileDirname}\\output\\${fileBasenameNoExtension}.exe"
            ], 
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\Program Files\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "label": "runTestCases",
            "command": "${command:cph.runTestCases}"
        },
        {
            "label": "copyFilePath",
            "command": "${command:copyFilePath}"
        },
        {
            "label": "runTestCasesAndCopyPath",
            "dependsOrder": "sequence",
            "dependsOn": [
                "runTestCases",
                "copyFilePath"
            ],
            "problemMatcher": []
        }
    ],
    "version": "2.0.0"
}